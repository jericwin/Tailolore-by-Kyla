# Copy to .env and adjust. Never commit the real .env.

# "production" enables secure cookies, HSTS and template caching, and uses data/tailored.db.
NODE_ENV=development
PORT=3000
# Public address of the site (used in logs and links)
BASE_URL=http://localhost:3000

# Set to 1 when running behind a reverse proxy / platform load balancer (needed for secure cookies).
TRUST_PROXY=

# Where data lives. Back both up. Defaults: ./data/tailored(-dev).db and ./storage
DATABASE_FILE=
STORAGE_DIR=

# How long a sign-in lasts (days)
SESSION_DAYS=14
# Maximum size of one uploaded photograph (MB)
UPLOAD_MAX_MB=12

# Optional: local background removal with rembg (MIT). Full path to the rembg executable.
# Windows example: C:\path\to\project\.venv-rembg\Scripts\rembg.exe
# Linux example:   /srv/tailored/.venv-rembg/bin/rembg
REMBG_PATH=
# isnet-general-use (default) | u2net | birefnet-general (best edges, larger download)
REMBG_MODEL=isnet-general-use
# 1 (default) refines soft edges like tulle; set 0 for faster processing
REMBG_ALPHA_MATTING=1

# Only for unattended first setup with `npm run create-admin` (remove afterwards).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
