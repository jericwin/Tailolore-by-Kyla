{% extends "layouts/site.njk" %}
{% import "partials/macros.njk" as m with context %}
{% block title %}Sign in · {{ site.brand_name }}{% endblock %}

{% block main %}
<div class="auth">
  <div class="auth__side" aria-hidden="true">
    <img src="/static/img/brand/monogram-ivory.png" alt="" width="400" height="333">
    <span class="note">{{ site.brand_name }}{% if site.location %} — {{ site.location }}{% endif %}</span>
  </div>
  <div class="auth__panel">
    <div>
      <p class="note">One sign-in for customers and the studio</p>
      <h1>Sign <em>in</em></h1>
    </div>
    <form method="post" action="/login">
      {{ m.csrf() }}
      <input type="hidden" name="next" value="{{ next }}">
      {% if formError %}<p class="form-error" role="alert">{{ formError }}</p>{% endif %}
      {{ m.field('email', 'Email', values, errors, type='email', required=true, attrs='autocomplete="email" autofocus') }}
      <div class="field">
        <label for="f-password">Password</label>
        <input class="input" id="f-password" name="password" type="password" required autocomplete="current-password">
        <a class="hint" href="/forgot-password">Forgotten your password?</a>
      </div>
      <button class="btn btn--block" type="submit">Sign in</button>
    </form>
    <p class="small muted">You’ll go straight to the right place: customers to their account — rentals, purchases, made-to-order requests and messages — and Kyla to the studio.</p>
    <p class="small">New here? <a href="/register{% if next %}?next={{ next | urlencode }}{% endif %}">Create an account</a> to rent, buy or commission a gown and follow your requests.</p>
  </div>
</div>
{% endblock %}
