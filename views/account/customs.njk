{% extends "layouts/account.njk" %}
{% import "partials/macros.njk" as m with context %}
{% block title %}Custom orders · {{ site.brand_name }}{% endblock %}

{% block content %}
<header class="acct__head"><p class="note">Custom orders</p><h1 class="h1">Made <em>for you</em></h1></header>
{% if customs.length %}
<ul class="ledger" role="list">
  {% for c in customs %}
  <li><a href="/account/custom/{{ c.id }}" class="ledger__row">
    <span class="ledger__thumb ledger__thumb--mark" aria-hidden="true">{{ loop.index | pad }}</span>
    <span class="ledger__main">
      <span class="ledger__title">{{ c.event_type }}</span>
      <span class="note">{{ c.reference }}{% if c.event_date %} · {{ c.event_date | date }}{% endif %} · sent {{ c.created_at | stamp }}</span>
    </span>
    {{ m.statusMark(status.CUSTOM, c.status) }}
  </a></li>
  {% endfor %}
</ul>
<p style="margin-top: 2rem"><a class="link" href="/commission">New request <span class="arrow">→</span></a></p>
{% else %}
<div class="acct__empty"><p class="lede">No custom requests yet.</p><a class="link" href="/commission">Request a custom gown <span class="arrow">→</span></a></div>
{% endif %}
{% endblock %}
