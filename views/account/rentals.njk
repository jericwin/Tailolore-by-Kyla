{% extends "layouts/account.njk" %}
{% import "partials/macros.njk" as m with context %}
{% block title %}My rentals · {{ site.brand_name }}{% endblock %}

{% block content %}
<header class="acct__head"><p class="note">My rentals</p><h1 class="h1">Rentals</h1></header>
{% if rentals.length %}
<ul class="ledger" role="list">
  {% for r in rentals %}
  <li><a href="/account/rentals/{{ r.id }}" class="ledger__row">
    <span class="ledger__thumb">{% if r.thumb_key %}<img src="{{ imgSrc(r.thumb_key, 480) }}" alt="" loading="lazy">{% endif %}</span>
    <span class="ledger__main">
      <span class="ledger__title">{{ r.gown_name }}</span>
      <span class="note">{{ r.reference }} · {{ r.pickup_date | date('short') }} → {{ r.return_date | date('short') }} · event {{ r.event_date | date }}</span>
    </span>
    {{ m.statusMark(status.RENTAL, r.status) }}
  </a></li>
  {% endfor %}
</ul>
{% else %}
<div class="acct__empty"><p class="lede">No rentals yet.</p><a class="link" href="/collection?service=rent">Gowns to rent <span class="arrow">→</span></a></div>
{% endif %}
{% endblock %}
